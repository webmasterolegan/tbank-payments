{
    "name": "webmasterolegan/tbank-payments",
    "description": "PHP 8.5+ SDK для работы с API интернет-эквайринга T-Bank (Тинькофф)",
    "version": "0.9.2",
    "type": "library",
    "license": "MIT",
    "keywords": ["tbank", "tinkoff", "payments", "acquiring", "sdk", "api", "integration"],
    "authors": [
        {
            "name": "Oleg Polyakov",
            "email": "oleg@webmastersdv.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-uri": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 HTTP client implementation",
        "symfony/http-client": "PSR-18 HTTP client implementation"
    },
    "autoload": {
        "psr-4": {
            "TBank\\Payments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TBank\\Payments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --configuration=phpstan.neon",
        "ci": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
